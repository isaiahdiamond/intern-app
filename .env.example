# Copy to .env and fill in. .env is gitignored — never commit it.

# Claude API — skill extraction
ANTHROPIC_API_KEY=

# The Muse (free key: https://www.themuse.com/developers/api/v2)
MUSE_API_KEY=

# Adzuna (free tier ~1000 calls/month: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs (free key: https://developer.usajobs.gov/APIRequest)
# USAJOBS_EMAIL is sent as the User-Agent and must be the registered address.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Gmail API (read-only) — path to the OAuth client secret you download from
# Google Cloud, and where the resulting token gets cached. Both gitignored.
GMAIL_CLIENT_SECRET_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Optional: JSearch via RapidAPI, your own key
JSEARCH_API_KEY=

# Local overrides
INTERN_APP_DB=data/intern_app.db
