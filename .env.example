# Copy to .env and fill in. .env is gitignored — never commit it.

# Claude API — skill extraction
ANTHROPIC_API_KEY=

# The Muse (free key: https://www.themuse.com/developers/api/v2)
MUSE_API_KEY=

# Adzuna (free tier ~1000 calls/month: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs (free key: https://developer.usajobs.gov/APIRequest)
# USAJOBS_EMAIL is sent as the User-Agent and must be the registered address.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# LinkedIn job-alert emails, read over IMAP from Yahoo Mail.
# YAHOO_APP_PASSWORD is an app password, not your account password: Yahoo blocks
# the normal one for third-party apps. Generate one at
# https://login.yahoo.com/account/security -> "Generate app password".
# The mailbox is opened read-only and only LinkedIn senders are searched.
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
YAHOO_IMAP_HOST=imap.mail.yahoo.com

# Optional: JSearch via RapidAPI, your own key
JSEARCH_API_KEY=

# Local overrides
INTERN_APP_DB=data/intern_app.db
